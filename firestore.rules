rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------------
    // Helper functions
    // ---------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // The caller's role is ALWAYS read from their server-side profile document,
    // never from anything the client sends.
    function callerRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function hasProfile() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isExtensionOfficer() {
      return hasProfile() && callerRole() == 'extension_officer';
    }

    // DEMO officer code. Anyone who knows these 4 digits can create an extension officer account.
    // Change it before real use (it appears in README.md for the hackathon demo).
    function officerCode() {
      return '4827';
    }

    // True when the SAME batch also writes officerClaims/{uid} holding the correct code.
    function hasOfficerCode(userId) {
      return getAfter(/databases/$(database)/documents/officerClaims/$(userId)).data.pin == officerCode();
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // ---------------------------------------------------------------
    // Users: a new account is a 'farmer', or an 'extension_officer' when it comes with the correct
    // 4-digit officer code. After sign-up nobody can change their own role.
    // ---------------------------------------------------------------
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
        isValidId(userId) &&
        incoming().uid == userId &&
        (incoming().role == 'farmer' ||
          (incoming().role == 'extension_officer' && hasOfficerCode(userId)));

      allow update: if isOwner(userId) &&
        incoming().uid == existing().uid &&
        incoming().role == existing().role;

      allow delete: if false;
    }

    // ---------------------------------------------------------------
    // Officer code claims: written together with a new officer account so the rules can check
    // the code. Only the owner can read their own; nobody can change or delete one.
    // ---------------------------------------------------------------
    match /officerClaims/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) &&
        isValidId(userId) &&
        incoming().uid == userId &&
        incoming().pin is string &&
        incoming().pin.matches('^[0-9]{4}$');
      allow update, delete: if false;
    }

    // ---------------------------------------------------------------
    // Diagnoses (a farmer's saved history)
    // ---------------------------------------------------------------
    match /diagnoses/{diagnosisId} {
      allow get: if isSignedIn() && (existing().userId == request.auth.uid || isExtensionOfficer());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isExtensionOfficer());
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && existing().userId == request.auth.uid && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // ---------------------------------------------------------------
    // Escalations (extension officer queue)
    // Farmers see only their own; officers see all; only officers can update.
    // ---------------------------------------------------------------
    match /escalations/{ticketId} {
      allow get: if isSignedIn() && (existing().userId == request.auth.uid || isExtensionOfficer());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isExtensionOfficer());
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isExtensionOfficer() && incoming().userId == existing().userId;
      allow delete: if false; // Preserve audit history
    }

    // Connection test document
    match /test/connection {
      allow read: if true;
      allow write: if false;
    }
  }
}
