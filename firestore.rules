rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------------
    // Helper functions
    // ---------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // The caller's role is ALWAYS read from their server-side profile document,
    // never from anything the client sends.
    function callerRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function hasProfile() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isExtensionOfficer() {
      return hasProfile() && callerRole() == 'extension_officer';
    }

    function isAdmin() {
      return hasProfile() && callerRole() == 'admin';
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // ---------------------------------------------------------------
    // Users: role is set to 'farmer' at sign-up and can only be changed by an admin.
    // 'admin' can never be granted from the app - set it by hand in the Firebase console.
    // ---------------------------------------------------------------
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();

      // Everyone starts as a farmer. Officer access goes through /officerRequests.
      allow create: if isOwner(userId) &&
        isValidId(userId) &&
        incoming().uid == userId &&
        incoming().role == 'farmer';

      allow update: if
        // The owner may edit their details but never their uid or role
        (isOwner(userId) &&
          incoming().uid == existing().uid &&
          incoming().role == existing().role)
        ||
        // An admin may ONLY change role (and the timestamp), and only to farmer/officer
        (isAdmin() &&
          incoming().uid == existing().uid &&
          incoming().diff(existing()).affectedKeys().hasOnly(['role', 'updatedAt']) &&
          incoming().role in ['farmer', 'extension_officer']);

      allow delete: if false;
    }

    // ---------------------------------------------------------------
    // Officer requests: a user asks to become an extension officer; an admin approves.
    // ---------------------------------------------------------------
    match /officerRequests/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();

      allow create: if isOwner(userId) &&
        isValidId(userId) &&
        incoming().uid == userId &&
        incoming().status == 'pending';

      allow update: if
        // Owner can edit their details while it is still pending
        (isOwner(userId) &&
          existing().status == 'pending' &&
          incoming().status == 'pending' &&
          incoming().uid == existing().uid)
        ||
        // Admin can only decide the request
        (isAdmin() &&
          incoming().uid == existing().uid &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'reviewedAt', 'reviewedBy']) &&
          incoming().status in ['approved', 'rejected']);

      allow delete: if false;
    }

    // ---------------------------------------------------------------
    // Diagnoses (a farmer's saved history)
    // ---------------------------------------------------------------
    match /diagnoses/{diagnosisId} {
      allow get: if isSignedIn() && (existing().userId == request.auth.uid || isExtensionOfficer());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isExtensionOfficer());
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && existing().userId == request.auth.uid && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // ---------------------------------------------------------------
    // Escalations (extension officer queue)
    // Farmers see only their own; officers see all; only officers can update.
    // ---------------------------------------------------------------
    match /escalations/{ticketId} {
      allow get: if isSignedIn() && (existing().userId == request.auth.uid || isExtensionOfficer());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isExtensionOfficer());
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isExtensionOfficer() && incoming().userId == existing().userId;
      allow delete: if false; // Preserve audit history
    }

    // Connection test document
    match /test/connection {
      allow read: if true;
      allow write: if false;
    }
  }
}
