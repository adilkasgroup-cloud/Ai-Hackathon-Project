rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isExtensionOfficer() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'extension_officer';
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isOwner(userId) || isExtensionOfficer();
      allow list: if isExtensionOfficer();
      allow create: if isOwner(userId) &&
        isValidId(userId) &&
        incoming().uid == userId &&
        incoming().role in ['farmer', 'extension_officer'];
      allow update: if isOwner(userId) &&
        incoming().uid == existing().uid &&
        incoming().role == existing().role;
      allow delete: if false;
    }

    // Diagnoses Collection
    match /diagnoses/{diagnosisId} {
      allow get: if isSignedIn() && (existing().userId == request.auth.uid || isExtensionOfficer());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isExtensionOfficer());
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && existing().userId == request.auth.uid && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // Escalations Collection (Extension Officer Queue)
    match /escalations/{ticketId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isExtensionOfficer() || 
        (resource.data.userId == request.auth.uid && incoming().userId == existing().userId)
      );
      allow delete: if false; // Preserve field extension audit history
    }

    // Connection test document
    match /test/connection {
      allow read: if true;
      allow write: if false;
    }
  }
}
